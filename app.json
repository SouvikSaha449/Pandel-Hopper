{
  "expo": {
    "name": "pandel_hopper",
    "slug": "pandel_hopper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pandel_hopper_logo.png",
    "scheme": "pandelhopper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show Durga Puja pandals near your location."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pandel_hopper_logo.png",
        "backgroundColor": "#FBF7F0"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/pandel_hopper_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0",
          "dark": {
            "image": "./assets/images/pandel_hopper_logo.png",
            "backgroundColor": "#171325"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationInUsePermission": "Show Durga Puja pandals near your location."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
